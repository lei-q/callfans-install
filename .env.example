# --- Harbor ---
# 注意协议：仓库不支持 https 时写 http://（oras 拉取也走 http）
#HARBOR_API_URL=https://harbor.example.com
#HARBOR_PROJECT=callfans
#HARBOR_USERNAME=
#HARBOR_PASSWORD=

# --- 安装器写入（Windows 安装时自动填） ---
# APP_ROOT=      # 本更新程序根目录
# DEPLOY_ROOT=   # 平台部署根目录

# --- 检查 ---
CHECK_INTERVAL_HOURS=6
# 排除的 tag（逗号分隔）
TAG_EXCLUDE=latest,dev

# --- server（docker 镜像）更新 ---
COMPOSE_FILE=/opt/callfans/docker-compose.yml

# --- 前端静态文件 ---
FRONTEND_OUTPUT_DIR=/opt/callfans/webroot

# --- SQL / B 库（sqlsync）---
# 以下可不填，默认值兜底：127.0.0.1 / 3306 / root / 123456
# MYSQL_HOST=
# MYSQL_PORT=
# MYSQL_USER=
# MYSQL_PASSWORD=
# B 库名无需单独配置：sqlsync 按云端库名同名对应，缺失时自动建库
# （MYSQL_DATABASE 仅旧模块使用，可留空）
# MYSQL_DATABASE=callfans

# --- 云端标准库（sqlsync）---
# 连接已内置于程序（47.87.66.98:13322 client_sync），不写在配置文件。
# 默认多库模式：自动发现云端全部非系统库，B 库缺失的库自动创建。
# 如只需同步单个库，取消下一行注释并填云端实际库名
# （注意库名可能含连字符，以下划线写会报 1049 Unknown database）：
# CLOUD_DB_NAME=callfans-standard
# CLOUD_DB_CA=/path/to/ca.pem

# --- sqlsync 策略（护栏阈值可调，护栏本身不可关） ---
# SQLSYNC_INTERVAL_HOURS=6
# SQLSYNC_MAX_STATEMENTS=200
# SQLSYNC_MAX_TABLE_RATIO=0.30
# SQLSYNC_MAX_DELETE_ROWS=1000

# --- 更新执行 ---
HEALTH_WAIT_SECONDS=60
DOCKER_STOP_TIMEOUT=15
# 单个镜像 pull 超过该秒数弹「继续/中断」确认（默认 600s=10 分钟）
# DOCKER_PULL_CONFIRM_SECONDS=600
# 单个镜像 pull 硬上限（默认 3600s=1 小时；2GB 镜像在慢网络下可 >30 分钟）
# DOCKER_PULL_TIMEOUT_SECONDS=3600

# --- 服务（可选）：固定 IPC 端口；不配则随机 ---
# BIND_PORT=53124
