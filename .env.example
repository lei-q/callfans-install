# --- Harbor ---
# 注意协议：仓库不支持 https 时写 http://（oras 拉取也走 http）
HARBOR_API_URL=https://harbor.example.com
HARBOR_PROJECT=callfans
HARBOR_USERNAME=robot$callfans
HARBOR_PASSWORD=***

# --- 检查 ---
CHECK_INTERVAL_HOURS=6
# 排除的 tag（逗号分隔）
TAG_EXCLUDE=latest,dev

# --- server（docker 镜像）更新 ---
COMPOSE_FILE=/opt/callfans/docker-compose.yml

# --- 前端静态文件 ---
FRONTEND_OUTPUT_DIR=/opt/callfans/webroot

# --- SQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=callfans
MYSQL_PASSWORD=***
# 库名可选：不配置时由 .sql 文件内的 USE 语句自行指定
# MYSQL_DATABASE=callfans

# --- 更新执行 ---
HEALTH_WAIT_SECONDS=60
DOCKER_STOP_TIMEOUT=15

# --- 服务（可选）：固定 IPC 端口；不配则随机 ---
# BIND_PORT=53124
